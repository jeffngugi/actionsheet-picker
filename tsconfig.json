{
  "compilerOptions": {
    "rootDir": ".",
    "paths": {
      "actionsheet-picker": ["./src/index"],
      "actionsheet-picker/react-hook-form": ["./src/adapters/react-hook-form"],
      // The example has its own copy (Metro resolves peers from the app);
      // point type-checking at one copy so `Control` types line up.
      "react-hook-form": ["./node_modules/react-hook-form"]
    },
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "customConditions": [
      "actionsheet-picker-source",
      "react-native-strict-api"
    ],
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "lib": ["ESNext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ESNext",
    "verbatimModuleSyntax": true
  }
}
