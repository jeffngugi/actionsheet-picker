{
  "name": "actionsheet-picker",
  "version": "0.0.0",
  "description": "Searchable, hierarchical, infinite-scrolling single/multi action-sheet picker for React Native. Zero native dependencies.",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "actionsheet-picker-source": "./src/index.tsx",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./react-hook-form": {
      "actionsheet-picker-source": "./src/adapters/react-hook-form.tsx",
      "types": "./lib/typescript/src/adapters/react-hook-form.d.ts",
      "default": "./lib/module/adapters/react-hook-form.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "react-hook-form",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "example": "yarn workspace actionsheet-picker-example",
    "clean": "del-cli lib",
    "prepare": "bob build",
    "typecheck": "tsc",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "test": "jest",
    "release": "release-it --only-version",
    "compat": "bash scripts/compat-check.sh",
    "docs:dev": "yarn workspace actionsheet-picker-docs dev",
    "docs:build": "yarn workspace actionsheet-picker-docs build",
    "docs:preview": "yarn workspace actionsheet-picker-docs preview"
  },
  "keywords": [
    "react-native",
    "ios",
    "android",
    "picker",
    "select",
    "action-sheet",
    "bottom-sheet",
    "dropdown",
    "searchable",
    "multiselect",
    "infinite-scroll",
    "hierarchical",
    "react-hook-form"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeffngugi/actionsheet-picker.git"
  },
  "author": "Geoffrey Ngugi <ngugimwathi254@gmail.com> (https://github.com/jeffngugi)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jeffngugi/actionsheet-picker/issues"
  },
  "homepage": "https://github.com/jeffngugi/actionsheet-picker#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/compat": "^2.1.0",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.39.5",
    "@jest/globals": "^29.7.0",
    "@react-native/babel-preset": "0.86.2",
    "@react-native/eslint-config": "0.86.2",
    "@react-native/jest-preset": "0.86.2",
    "@release-it/conventional-changelog": "^12.0.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/react": "^19.2.0",
    "commitlint": "^21.2.1",
    "del-cli": "^7.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ft-flow": "^3.0.11",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^29.7.0",
    "lefthook": "^2.1.10",
    "prettier": "^3.9.6",
    "react": "19.2.3",
    "react-hook-form": "^7.89.0",
    "react-native": "0.86.3",
    "react-native-builder-bob": "^0.43.0",
    "release-it": "^21.0.1",
    "test-renderer": "^1.0.0",
    "turbo": "^2.10.8",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-hook-form": ">=7.40",
    "react-native": ">=0.72",
    "react-native-safe-area-context": ">=4"
  },
  "workspaces": [
    "example",
    "docs"
  ],
  "packageManager": "yarn@4.11.0",
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "create-react-native-library": {
    "type": "library",
    "languages": "js",
    "tools": [
      "eslint",
      "jest",
      "lefthook",
      "release-it"
    ],
    "version": "0.63.1"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "angular"
        },
        "infile": "CHANGELOG.md",
        "header": "# Changelog"
      }
    }
  },
  "jest": {
    "preset": "@react-native/jest-preset",
    "testEnvironmentOptions": {
      "customExportConditions": [
        "require",
        "react-native",
        "actionsheet-picker-source"
      ]
    },
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ]
  },
  "sideEffects": false,
  "peerDependenciesMeta": {
    "react-hook-form": {
      "optional": true
    },
    "react-native-safe-area-context": {
      "optional": true
    }
  }
}
